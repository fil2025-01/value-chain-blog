---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
---

<Base title="Value Chain Blog — Engineering & Architecture Insights">
  <section style="margin-bottom: 3rem; text-align: center;">
    <span class="tag" style="margin-bottom: 1rem; display: inline-block;">Knowledge Hub</span>
    <h1 style="font-size: 2.8rem; font-weight: 800; letter-spacing: -0.03em; margin: 0.5rem 0 1rem; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Value Chain Engineering Blog
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 36rem; margin: 0 auto;">
      Technical documentation, role capabilities, system architecture, and development guidelines.
    </p>
  </section>

  <div class="post-grid">
    {
      posts.map((post) => {
        const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
        const readTime = Math.max(1, Math.ceil(wordCount / 200));

        return (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div>
              <div class="post-card-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {post.data.pubDate.toLocaleDateString('en-US', dateFormat)}
                <span>• {readTime} min read</span>
              </div>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-desc">{post.data.description}</p>
            </div>
            
            <div class="post-card-footer">
              <span>Read article</span>
              <span class="read-more-arrow">→</span>
            </div>
          </a>
        );
      })
    }
  </div>
</Base>
