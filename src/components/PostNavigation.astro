---
interface PostSummary {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    tags: string[];
  };
  body?: string;
}

interface Props {
  prevPost?: PostSummary;
  nextPost?: PostSummary;
}

const { prevPost, nextPost } = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
};

function getReadTime(body?: string) {
  if (!body) return 1;
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}
---

{
  (prevPost || nextPost) && (
    <nav class="post-nav-container" aria-label="Post navigation">
      <div class="post-nav-grid">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}/`} class="post-nav-card post-nav-prev" title={prevPost.data.title}>
            <div class="post-nav-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="nav-arrow">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Previous Article</span>
            </div>
            <div class="post-nav-title">{prevPost.data.title}</div>
            <div class="post-nav-meta">
              <span>{prevPost.data.pubDate.toLocaleDateString('en-US', dateFormat)}</span>
              <span>•</span>
              <span>{getReadTime(prevPost.body)} min read</span>
            </div>
          </a>
        ) : (
          <div class="post-nav-placeholder" aria-hidden="true"></div>
        )}

        {nextPost ? (
          <a href={`/blog/${nextPost.id}/`} class="post-nav-card post-nav-next" title={nextPost.data.title}>
            <div class="post-nav-badge">
              <span>Next Article</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="nav-arrow">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
            <div class="post-nav-title">{nextPost.data.title}</div>
            <div class="post-nav-meta">
              <span>{nextPost.data.pubDate.toLocaleDateString('en-US', dateFormat)}</span>
              <span>•</span>
              <span>{getReadTime(nextPost.body)} min read</span>
            </div>
          </a>
        ) : (
          <div class="post-nav-placeholder" aria-hidden="true"></div>
        )}
      </div>

      <div class="post-nav-actions">
        <a href="/" class="post-nav-all-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Back to all articles
        </a>

        <button type="button" class="post-nav-top-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
          Back to top
        </button>
      </div>
    </nav>
  )
}

<style>
  .post-nav-container {
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .post-nav-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-nav-placeholder {
    display: none;
  }

  @media (min-width: 640px) {
    .post-nav-placeholder {
      display: block;
    }
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.35rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    text-decoration: none !important;
    color: inherit;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .post-nav-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-gradient);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .post-nav-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-accent);
    background: var(--bg-card-hover);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2), 0 0 18px var(--accent-glow);
  }

  .post-nav-card:hover::before {
    opacity: 1;
  }

  .post-nav-prev {
    text-align: left;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    margin-bottom: 0.65rem;
  }

  .post-nav-next .post-nav-badge {
    justify-content: flex-end;
    margin-left: auto;
  }

  .nav-arrow {
    transition: transform 0.2s ease;
  }

  .post-nav-prev:hover .nav-arrow {
    transform: translateX(-4px);
  }

  .post-nav-next:hover .nav-arrow {
    transform: translateX(4px);
  }

  .post-nav-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.38;
    color: var(--text-main);
    margin: 0 0 0.65rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .post-nav-card:hover .post-nav-title {
    color: var(--accent-text);
  }

  .post-nav-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .post-nav-next .post-nav-meta {
    justify-content: flex-end;
  }

  .post-nav-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .post-nav-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-secondary);
    text-decoration: none !important;
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
  }

  .post-nav-all-link:hover {
    color: var(--accent-primary);
    border-color: var(--border-accent);
    background: var(--bg-card-hover);
    transform: translateY(-1px);
  }

  .post-nav-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .post-nav-top-btn:hover {
    color: var(--text-main);
    border-color: var(--border-accent);
    background: var(--bg-card-hover);
  }
</style>
